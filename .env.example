# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AIRTABLE INTEGRATION (TripMates Production Database)
# Personal access token with scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_API_KEY=""

# Airtable Base ID (starts with app...)
AIRTABLE_BASE_ID=""

# Admin dashboard master passkey (can also be entered in the Admin UI)
ADMIN_SECRET="tripmates_admin_2026"
